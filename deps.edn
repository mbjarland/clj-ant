{:paths   ["src/clj" "target/classes"]    ; src/java compiled here

 :deps    {org.clojure/clojure     {:mvn/version "1.11.4"}
           org.apache.ant/ant      {:mvn/version "1.10.17"}
           org.apache.ant/ant-jsch {:mvn/version "1.10.17"
                                    ;; ant-jsch transitively pulls in the
                                    ;; unmaintained com.jcraft:jsch:0.1.55,
                                    ;; which has CVE-2023-48795 (Terrapin)
                                    ;; unpatched. Exclude it and use the
                                    ;; maintained drop-in below instead.
                                    :exclusions [com.jcraft/jsch]}
           ;; Maintained drop-in for com.jcraft:jsch -- same package name,
           ;; has the Terrapin fix. Lets <scp>/<sshexec> work out of box.
           com.github.mwiede/jsch  {:mvn/version "0.2.25"}
           metosin/malli           {:mvn/version "0.16.4"}}

 :aliases {;; Stub generator. Walks Ant's defaults.properties and the
           ;; bundled Ant manual to produce src/clj/clj_ant/tasks.clj.
           ;;
           ;;   clj -X:gen
           :gen   {:exec-fn     clj-ant.gen/generate!
                   :extra-paths ["src/gen"]}

           ;; Compile the single Java bridge class into target/classes.
           ;; Required once before tests / development.  clj -T:build javac
           :build {:deps       {io.github.clojure/tools.build
                                {:git/tag "v0.10.5" :git/sha "2a21b7a"}}
                   :ns-default build}

           ;; nREPL for editor connections
           :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}}
                   :main-opts  ["-m" "nrepl.cmdline"]}

           ;; Tests:  clj -M:test
           :test  {:extra-paths ["test"]
                   :extra-deps  {lambdaisland/kaocha
                                 {:mvn/version "1.91.1392"}}
                   :main-opts   ["-m" "kaocha.runner"]}

           ;; Babashka pod entry point (see doc/babashka.md):
           ;;   bb -e '(require (quote [babashka.pods :as pods]))
           ;;          (pods/load-pod ["clojure" "-M:pod"]) ...'
           :pod   {:main-opts ["-m" "clj-ant.pod"]}}}
